<!DOCTYPE html>
<html lang="en">
    <% include('./partials/head') %>
<body>
        <div class="content">
            <% if (users.length > 0) { %>
                <% users.forEach(user => { %>
                    <h3 class="title">
                        <%= user.name %>
                    </h3>
                    <p><%= user.email %></p>
                <% }) %><% } else { %>
                    <p>No users found.</p>
                <% } %>
        </div>
</body>
</html>
